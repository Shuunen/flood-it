{
  "$schema": "https://json.schemastore.org/package",
  "author": "Romain Racamier-Lafon <romain.racamier@gmail.com>",
  "bugs": "https://github.com/Shuunen/flood-it/issues",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "preact": "^11.0.1",
    "shuutils": "^12.0.0"
  },
  "description": "A flood it game",
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@vitest/coverage-v8": "~5.0.5",
    "happy-dom": "^21.0.4",
    "knip": "^6.42.1",
    "oxlint": "^1.89.0",
    "repo-check": "^1.46.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "~5.0.5"
  },
  "files": [
    "src"
  ],
  "homepage": "https://github.com/Shuunen/flood-it",
  "keywords": [
    "flood-it",
    "game"
  ],
  "license": "GPL-3.0",
  "name": "@shuunen/flood-it",
  "packageManager": "pnpm@12.15.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shuunen/flood-it.git"
  },
  "scripts": {
    "build": "tsc -b && vite build && pnpm build:mark && echo build success",
    "build:mark": "unique-mark dist/index.{html} && echo build:mark success",
    "check": "pnpm install && echo install success && pnpm build && repo-check && pnpm lint && pnpm test && echo check success",
    "dev": "vite",
    "lint": "pnpm lint:tsc && pnpm lint:knip && pnpm lint:oxlint && echo lint success",
    "lint:knip": "knip && echo lint:knip success",
    "lint:oxlint": "oxlint src --deny-warnings --fix --fix-suggestions --fix-dangerously && echo lint:oxlint success",
    "lint:tsc": "tsc --noEmit && echo lint:tsc success",
    "postversion": "git push && git push --tags",
    "preversion": "pnpm check",
    "preview": "vite preview",
    "test": "vitest --run --coverage && echo test success"
  },
  "type": "module",
  "version": "2.0.0"
}
